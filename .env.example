# OpenAI-compatible runtime configuration
# ======================================

# Required for interactive agent and baseline LLM mode
OPENAI_API_KEY=sk-your-openai-compatible-key
# Required when inference.py runs with USE_LLM=true
HF_TOKEN=hf_your_token_here

# Hackathon-required defaults (also hardcoded in inference.py)
API_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Deterministic and low-resource defaults
MODEL_TEMPERATURE=0.0
SEED=42
USE_LLM=false
