# ============================================================================
# OpenAI Configuration (Required for inference.py)
# ============================================================================
# ⚠️  IMPORTANT: Never commit real keys. Use placeholders in this file.

# OpenAI API key (optional, enables LLM mode when USE_LLM=true)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here-never-commit-real-keys

# Hugging Face token (optional, for accessing HF-hosted models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hf_token_here

# ============================================================================
# Hackathon-Required Defaults (DO NOT CHANGE)
# ============================================================================
API_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ============================================================================
# Runtime Configuration
# ============================================================================
USE_LLM=false
MODEL_TEMPERATURE=0.0
SEED=42

# ============================================================================
# Local Development Only (not used in evaluation)
# ============================================================================
LOG_LEVEL=INFO
DEBUG=false
