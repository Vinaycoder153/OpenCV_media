# Google Gemini API Configuration
# ================================
#
# Get your API key from: https://aistudio.google.com/app/apikeys
# 
# Steps:
# 1. Visit https://aistudio.google.com/app/apikeys
# 2. Click "Create API Key"
# 3. Copy the key (starts with AIzaSy...)
# 4. Paste it below

GOOGLE_API_KEY=AIzaSyDDBC4w649X9gQqygrMkQTazVynsPg76zI

# Optional: Choose which Gemini model to use
# Available options:
#   - gemini-1.5-flash (default, fastest, cheapest)
#   - gemini-1.5-pro (higher quality, slower, more expensive)
#   - gemini-1.0-pro (older version, legacy)
GOOGLE_MODEL=gemini-2.0-flash

# Optional: Set sampling temperature (0.0 - 2.0)
# Lower values (0.0-0.5): More deterministic, structured output
# Higher values (1.5-2.0): More creative, varied output
GOOGLE_TEMPERATURE=0.7
